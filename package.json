{
  "name": "bookforge",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p .",
    "studio": "npm run studio:build --silent && tsx src/cli.ts studio",
    "studio:dev": "concurrently -k -n api,web -c blue,green \"tsx src/cli.ts studio\" \"vite --config studio/vite.config.ts\"",
    "studio:build": "vite build --config studio/vite.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Make a real EPUB from a PDF",
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "jszip": "^3.10.1",
    "mupdf": "^1.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "9.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "bin": {
    "bookforge": "dist/cli.js"
  }
}
